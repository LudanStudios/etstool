# 构建工具链与缓存（体积大，按 README 重新构建时自动生成）
.build/
.build-tools/
archive/

# .NET 编译中间产物
Installer/bin/
Installer/obj/
tests/**/bin/
tests/**/obj/
winui3/bin/
winui3/obj/

# Python 缓存
__pycache__/
*.py[co]
# .pyd 是发布程序必需的原生扩展，不能作为 Python 缓存忽略。
.venv/
venv/

# 日志与临时文件
*.log
*.tmp
temp/
_winui/aliyun_tts_credentials.bin
_winui/temp/
_winui/*.WebView2/
backend/cloudflare-worker/.dev.vars
backend/cloudflare-worker/.dev.vars.*
!backend/cloudflare-worker/.dev.vars.example
Thumbs.db
Desktop.ini
.DS_Store
