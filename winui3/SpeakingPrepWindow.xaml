<Window
    x:Class="ETSAssistant.WinUI3.SpeakingPrepWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ETSAssistant.WinUI3"
    Title="口语题准备">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid RowDefinitions="48,*">
            <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/ProgramIcon.png" Width="18" Height="18"
                           Stretch="Uniform" IsHitTestVisible="False" />
                    <TextBlock Text="ETS Tool" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="32,4,32,28" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="口语题准备" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="PackText" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderStatusText" Text="准备中" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="StartAutoButton" Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}" Click="StartAuto_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock x:Name="StartAutoButtonText" Text="开始自动口语" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"
                                           Text="正在检查口语题…" />
                                <TextBlock x:Name="ProgressCountText" Grid.Column="1" Text="0/0" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="1" Value="0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="题目" FontSize="14" FontWeight="SemiBold" />

                    <ItemsControl x:Name="QuestionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SpeakingPrepItem">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                                        <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Prompt}" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Kind}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
