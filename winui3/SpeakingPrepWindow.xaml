<Window
    x:Class="ETSAssistant.WinUI3.SpeakingPrepWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ETSAssistant.WinUI3"
    Title="口语题准备">
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Padding="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <SymbolIcon Symbol="Audio" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="口语题准备" />
            <TextBlock x:Name="PackText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar x:Name="OverallProgress" Grid.Row="1" Minimum="0" Maximum="1" Value="0" />

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                   Text="正在检查口语题…" />

        <ListView x:Name="QuestionList" Grid.Row="3" MinHeight="120" MaxHeight="230" SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SpeakingPrepItem">
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="8" Padding="0,2">
                        <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#EF4444" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="关闭" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
