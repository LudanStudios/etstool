<Window
    x:Class="ETSAssistant.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ETS Tool by @azursmelt">
    <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="Transparent" RowDefinitions="48,*">
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="11" Margin="20,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/ProgramIcon.png" Width="24" Height="24"
                       Stretch="Uniform" IsHitTestVisible="False" />
                <TextBlock Text="ETS Tool by @azursmelt" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        Background="Transparent"
                        SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#D918212E" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#D918212E" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="运行概览" Tag="overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="试卷管理" Tag="papers">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="答题设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="运行记录" Tag="logs">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="测试工具" Tag="tools">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="使用说明" Tag="guide">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="偏好设置" Tag="preferences">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="PageFrame" />
        </NavigationView>
    </Grid>
</Window>
