<Page
    x:Class="ETSAssistant.WinUI3.Pages.EtsPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">
    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30"
          RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon x:Name="PageTitleIcon" Symbol="View" Width="25" Height="25"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
            <TextBlock x:Name="PageTitleText" Grid.Column="1" Text="common.program_preview" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="PageDescriptionText" Grid.Row="1" Grid.Column="1"
                       Text="preview.automatically_find_running_ets_windows"
                       FontSize="15" Opacity="0.72" TextWrapping="Wrap" />
        </Grid>

        <Grid x:Name="PreviewToolbar" Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
            <Button x:Name="StartEtsButton" Click="StartEtsButton_Click"
                    Width="40" Height="40" Padding="0" ToolTipService.ToolTip="preview.start_ets"
                    AutomationProperties.Name="preview.start_ets"
                    Style="{StaticResource AccentButtonStyle}">
                <SymbolIcon Symbol="Play" />
            </Button>
            <Button x:Name="ConnectButton" Grid.Column="1" Click="ConnectButton_Click" MinHeight="40">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="preview.recheck" />
                </StackPanel>
            </Button>
            <Button x:Name="EndEtsButton" Grid.Column="2"
                    Width="40" Height="40" Padding="0" ToolTipService.ToolTip="common.end_ets_processes"
                    AutomationProperties.Name="common.end_ets_processes"
                    Background="#C42B1C" Foreground="White" BorderBrush="#C42B1C">
                <Button.Flyout>
                    <Flyout x:Name="EndEtsFlyout" Placement="Top"
                            Opened="EndEtsFlyout_Opened" Closed="EndEtsFlyout_Closed">
                        <StackPanel Width="260" Spacing="10">
                            <TextBlock x:Name="EndEtsConfirmationTitle" Text="common.end_ets_processes_2" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="EndEtsConfirmationMessage" Text="preview.ets_close_immediately_unsaved_work" TextWrapping="Wrap" Opacity="0.8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button x:Name="CancelEndEtsButton" Content="common.cancel" Click="CancelEndEtsFlyout_Click" />
                                <Button x:Name="ConfirmEndEtsButton" Content="common.end_ets"
                                        Background="#C42B1C" Foreground="White" BorderBrush="#C42B1C"
                                        Click="ConfirmEndEts_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <SymbolIcon Symbol="Stop" />
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <ProgressRing x:Name="ConnectionRing" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="ConnectionStatus" Text="preview.opening_this_page_does_not" TextWrapping="Wrap"
                           VerticalAlignment="Center" Opacity="0.78" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="0" CornerRadius="12" Background="#FF11151B"
                BorderThickness="0">
            <Grid x:Name="PreviewViewport" Background="#FF11151B"
                  SizeChanged="PreviewViewport_SizeChanged">
                <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="10" MaxWidth="440" Margin="24">
                    <SymbolIcon Symbol="View" Width="34" Height="34" HorizontalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="preview.ets_window_appear_here" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="preview.running_ets_windows_appear_here"
                               Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
