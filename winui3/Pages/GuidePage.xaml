<Page
    x:Class="ETSAssistant.WinUI3.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel x:Name="ResponsiveContent" Margin="30,26,30,30" Spacing="18">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                <SymbolIcon Symbol="Help" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="common.guide" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="guide.manage_monitoring_papers_answer_options" FontSize="15" Opacity="0.72" />
            </Grid>
            <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <SymbolIcon Symbol="Play" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="common.quick_start" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="guide.make_sure_ets_installed_app" TextWrapping="Wrap" />
                    <TextBlock Text="guide.place_numeric_paper_packs_appdata" TextWrapping="Wrap" />
                    <TextBlock Text="guide.use_initialize_open_ets_create" TextWrapping="Wrap" />
                    <TextBlock Text="guide.assistant_window_opens_ets_converted" TextWrapping="Wrap" />
                    <TextBlock Text="guide.answering_uses_local_ets_debugging" TextWrapping="Wrap" Opacity="0.76" />
                    <Button Click="OpenReadme_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="guide.open_full_readme" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
