<Page
    x:Class="ETSAssistant.WinUI3.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="30,26,30,30" Spacing="18">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                <SymbolIcon Symbol="Help" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="使用说明" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="从界面管理监听、试卷和答题选项。" FontSize="15" Opacity="0.72" />
            </Grid>
            <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <SymbolIcon Symbol="Play" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="快速开始" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="1. 确认 ETS 已安装，程序会自动查找常见安装位置和 Windows 安装记录。" TextWrapping="Wrap" />
                    <TextBlock Text="2. 将数字编号试卷包放入 %APPDATA%\ETS，并保留原有 JSON 文件和目录结构。" TextWrapping="Wrap" />
                    <TextBlock Text="3. 使用“初始化并打开 ETS”创建快捷方式、启动后台监听并打开 ETS。以后登录 Windows 后，监听器会在后台等待。" TextWrapping="Wrap" />
                    <TextBlock Text="4. ETS 启动时助手窗口会自动弹出；试卷转换结果保存在试卷包的 converted 子目录。" TextWrapping="Wrap" />
                    <TextBlock Text="答题辅助依赖 ETS 本机调试接口。程序不会自动点击最终提交按钮。" TextWrapping="Wrap" Opacity="0.76" />
                    <Button Click="OpenReadme_Click" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="打开完整 README" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
