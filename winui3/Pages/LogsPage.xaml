<Page
    x:Class="ETSAssistant.WinUI3.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30" RowDefinitions="Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                <SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="运行记录" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="监听器、转换和答题进程的最近状态。" FontSize="15" Opacity="0.72" />
            </Grid>
            <Button Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="立即刷新" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Padding="16" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer x:Name="LogScrollViewer">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
