<Page
    x:Class="ETSAssistant.WinUI3.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="30,26,30,30" Spacing="20">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                <FontIcon Glyph="&#xE80F;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="运行概览" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="ETS 启动后，助手会自动打开并开始监听。" FontSize="15" Opacity="0.72" />
            </Grid>
            <InfoBar x:Name="EtsErrorBar" IsOpen="False" Severity="Error"
                     Title="没有找到 ETS 安装目录"
                     Message="请确认 ETS 已安装；也可以点击“选择 ETS 安装目录”手动指定。" />
            <InfoBar x:Name="GeneralInfoBar" IsOpen="False" Severity="Informational" />
            <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="ETS 安装状态" FontSize="13" Opacity="0.68" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Accept" Foreground="#4ADE80" />
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#22C55E" />
                        <TextBlock x:Name="StatusText" Text="正在检查…" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="EtsPathText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                               Text="" TextWrapping="Wrap" Opacity="0.76" />
                    <TextBlock x:Name="ListenerText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0"
                               Text="监听器会在 Windows 登录时后台启动。" FontSize="13" Opacity="0.76" />
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
                        <Button Click="InitializeAndOpen_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="初始化并打开 ETS" />
                            </StackPanel>
                        </Button>
                        <Button Click="OpenEts_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="只打开 ETS" />
                            </StackPanel>
                        </Button>
                        <Button Click="ChooseEtsFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="选择 ETS 安装目录" />
                            </StackPanel>
                        </Button>
                        <Button Click="Rescan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="重新扫描" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="当前试卷" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border x:Name="PaperStateBadge" Grid.Column="1" Padding="10,4" CornerRadius="8"
                                Background="#1F94A3B8" VerticalAlignment="Center">
                            <TextBlock x:Name="PaperStateText" Text="等待检测" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PaperTitleText" Text="尚未检测到正在作答的试卷" FontSize="19"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PaperMetaText" Text="启动 ETS 并打开试卷后，这里会显示答题进度和本地答案。"
                               FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
                    <StackPanel x:Name="PaperProgressPanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="PaperProgressText" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="PaperPercentText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <ProgressBar x:Name="PaperProgressBar" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="PaperCorrectText" FontSize="13" Opacity="0.72" />
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="试卷答案" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="绿色=一致 · 红色=不一致 · 灰色=未作答"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl x:Name="AnswerChips">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="82" ItemHeight="64" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="70" Height="56" Margin="0,0,10,8" CornerRadius="9"
                                            Background="{Binding Background}" ToolTipService.ToolTip="{Binding Tooltip}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding NumberText}" FontSize="11" Opacity="0.7"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Answer}" FontSize="18" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button x:Name="CopyAnswersButton" Click="CopyAnswers_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="一键复制所有答案" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ManualResetButton" Click="ManualReset_Click" IsEnabled="False"
                                    ToolTipService.ToolTip="先在 ETS 中手动切到第 1 题，再点击手动重置">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="手动重置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="手动重置：在 ETS 中切到第 1 题后点击，助手会清空本轮进度并从当前题目重新作答。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Sync" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="自动流程" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="打开 ETS 时启动助手窗口、试卷转换监听和答题监听。关闭 ETS 后，后台进程会停止并等待下次启动。"
                                   TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Folder" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="试卷数据位置" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
