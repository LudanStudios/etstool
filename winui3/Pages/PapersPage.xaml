<Page
    x:Class="ETSAssistant.WinUI3.Pages.PapersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon Symbol="Folder" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="试卷管理" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="查看本机试卷，打开目录、提取答案或删除。" FontSize="15" Opacity="0.72" />
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" />

        <Border Grid.Row="2" Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock x:Name="SummaryText" Text="正在读取本机试卷…" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                        <Button Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="130,*,Auto" Padding="12,4">
                    <TextBlock Text="试卷编号" FontSize="12" Opacity="0.62" />
                    <TextBlock Grid.Column="1" Text="使用 / 创建日期" FontSize="12" Opacity="0.62" />
                    <TextBlock Grid.Column="2" Text="操作" FontSize="12" Opacity="0.62" HorizontalAlignment="Left" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListView x:Name="PaperList" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="130,*,Auto" Padding="12,10" MinHeight="48">
                                    <TextBlock Text="{Binding PackId}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="上次使用：" Opacity="0.62" />
                                            <TextBlock Text="{Binding LastUsedText}" Opacity="0.76"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="创建：" Opacity="0.62" FontSize="12" />
                                            <TextBlock Text="{Binding CreatedText}" Opacity="0.62"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Click="OpenFolder_Click" Padding="0" Width="42" Height="38"
                                                AutomationProperties.Name="在文件资源管理器中打开"
                                                ToolTipService.ToolTip="在文件资源管理器中打开">
                                            <Viewbox Width="20" Height="20">
                                                <SymbolIcon Symbol="OpenFile" />
                                            </Viewbox>
                                        </Button>
                                        <Button Click="AnalyzeAnswers_Click" Padding="0" Width="42" Height="38"
                                                AutomationProperties.Name="分析答案并复制"
                                                ToolTipService.ToolTip="分析答案并复制">
                                            <Viewbox Width="20" Height="20">
                                                <SymbolIcon Symbol="FourBars" />
                                            </Viewbox>
                                        </Button>
                                        <Button Click="DetailedAnalysis_Click" Padding="0" Width="42" Height="38"
                                                Visibility="{Binding DetailedAnalysisVisibility}"
                                                AutomationProperties.Name="DeepSeek 详细解析 Beta"
                                                ToolTipService.ToolTip="DeepSeek 详细解析（Beta）">
                                            <Viewbox Width="20" Height="20"><SymbolIcon Symbol="Message" /></Viewbox>
                                        </Button>
                                        <Button Click="ExtractAnswers_Click" Padding="0" Width="42" Height="38"
                                                AutomationProperties.Name="提取答案"
                                                ToolTipService.ToolTip="提取答案">
                                            <Viewbox Width="20" Height="20">
                                                <SymbolIcon Symbol="Download" />
                                            </Viewbox>
                                        </Button>
                                        <Button Click="Delete_Click" Padding="0" Width="42" Height="38"
                                                AutomationProperties.Name="删除"
                                                Background="#1AEF4444" BorderBrush="#33EF4444" CornerRadius="6"
                                                Foreground="#F87171"
                                                ToolTipService.ToolTip="删除">
                                            <Viewbox Width="20" Height="20">
                                                <SymbolIcon Symbol="Delete" Foreground="#F87171" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" Text="还没有本机试卷。打开 ETS 并进入一份试卷后，这里会自动出现记录。"
                               Opacity="0.65" TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
