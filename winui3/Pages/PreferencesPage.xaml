<Page
    x:Class="ETSAssistant.WinUI3.Pages.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="30,26,30,30" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon Symbol="Setting" VerticalAlignment="Center"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="偏好设置" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="应用外观与语言。" FontSize="15" Opacity="0.72" />
        </Grid>

        <Border Padding="4" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <Grid ColumnDefinitions="40,*,Auto" Padding="16,16">
                    <SymbolIcon Symbol="Setting" Width="22" Height="22" VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="应用外观" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="选择浅色、深色或跟随系统。" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                              SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />

                <Grid ColumnDefinitions="40,*,Auto" Padding="16,16">
                    <SymbolIcon Symbol="Globe" Width="22" Height="22" VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.9" />
                    <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="语言" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="选择应用的显示语言。" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="180" VerticalAlignment="Center"
                              SelectionChanged="LanguageBox_SelectionChanged">
                        <ComboBoxItem Content="中文" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="更改会立即应用并保存。" FontSize="12" Opacity="0.65" Margin="4,0,0,0" />
    </StackPanel>
</Page>
