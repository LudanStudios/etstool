<Page
    x:Class="ETSAssistant.WinUI3.Pages.PreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel x:Name="ResponsiveContent" Margin="32,28,32,36" Spacing="26" MaxWidth="980" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="32,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="5">
                <SymbolIcon Symbol="Setting" VerticalAlignment="Center" Width="28" Height="28"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="common.preferences" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="preferences.personalize_ets_tool_appearance_privacy"
                           FontSize="15" Opacity="0.72" />
            </Grid>

            <StackPanel Spacing="10">
                <TextBlock Text="preferences.appearance" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,2" />
                <Border Padding="4" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="16,14">
                            <SymbolIcon Symbol="Setting" Width="21" Height="21" VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="preferences.app_mode" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="preferences.light_dark_follow_windows" FontSize="12" Opacity="0.68" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="178" VerticalAlignment="Center"
                                      SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="preferences.follow_system" /><ComboBoxItem Content="preferences.light" /><ComboBoxItem Content="preferences.dark" />
                            </ComboBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />
                        <Grid ColumnDefinitions="44,*,Auto" Padding="16,14">
                            <SymbolIcon Symbol="Globe" Width="21" Height="21" VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="preferences.display_language" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="preferences.choose_app_display_language" FontSize="12" Opacity="0.68" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="178" VerticalAlignment="Center"
                                      SelectionChanged="LanguageBox_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="preferences.services_privacy" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,2" />
                <Border Padding="4" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel x:Name="UpdateControlsPanel">
                            <Grid ColumnDefinitions="44,*,Auto" Padding="16,14">
                                <SymbolIcon Symbol="Download" Width="21" Height="21" VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0,22,0" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="preferences.check_updates_automatically" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="preferences.enabled_default_periodically_checks_github"
                                               FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="2" OnContent="common.on" OffContent="common.off"
                                              Toggled="AutoUpdateToggle_Toggled" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" />
                            <Grid ColumnDefinitions="44,*,Auto" Padding="16,14">
                                <SymbolIcon Symbol="Refresh" Width="21" Height="21" VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="preferences.manual_check" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText" Text="preferences.not_checked_yet" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="CheckUpdatesButton" Grid.Column="2" Click="CheckUpdates_Click"
                                        Content="preferences.check_now" VerticalAlignment="Center" />
                            </Grid>
                            <InfoBar x:Name="UpdateInfoBar" IsOpen="False" />
                        </StackPanel>
                        <TextBlock x:Name="InternalTestNoUpdatesText" Visibility="Collapsed"
                                   FontSize="14" Padding="16,18" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="preferences.settings_take_effect_immediately_saved" FontSize="12" Opacity="0.65" Margin="4,0,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
