<Page
    x:Class="ETSAssistant.WinUI3.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon Symbol="Repair" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="common.developer_tools" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="tools.advanced_diagnostics_virtual_microphone_packet"
                       FontSize="15" Opacity="0.72" />
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="tools.automatic_listening_test" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="tools.debug_port_log_tools_automatic" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="Globe" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="tools.local_debugging_port" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="PortDot" Width="9" Height="9" Fill="#94A3B8" />
                                <TextBlock x:Name="PortStatusText" Text="tools.checking" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="http://127.0.0.1:10086/json/list" FontFamily="Consolas" FontSize="14"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="tools.ets_must_run_remote_debugging"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenList_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="tools.view_json_list" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenVersion_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="tools.view_json_version" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyPort_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="tools.copy_address" />
                                </StackPanel>
                            </Button>
                            <Button Click="RefreshPort_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="common.refresh_status" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="World" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="tools.packet_capture" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CaptureToggle" Grid.Column="1" OnContent="" OffContent=""
                                          Toggled="CaptureToggle_Toggled" />
                        </Grid>
                        <TextBlock Text="tools.connects_devtools_network_domain_after"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="CaptureStatusText" Text="common.disabled" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="CapturePathText" FontFamily="Consolas" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap" />
                        <Button Click="OpenCapture_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Folder" />
                                <TextBlock Text="tools.open_capture_file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>



                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="tools.automatic_speaking_test" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="tools.speaking_question_analysis_deepseek_generation" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Play" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="tools.automatic_speaking" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource BetaBadgeStyle}">
                                <TextBlock Text="BETA" FontSize="10" FontWeight="SemiBold" Foreground="#FF5B430F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="tools.automatically_starts_practice_skips_prompt"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="SpeakingModeSummaryText" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.8" />
                            <Button x:Name="AutoSpeakingButton" Click="AutoSpeaking_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock x:Name="AutoSpeakingButtonText" Text="common.start_automatic_speaking" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="AutoSpeakingStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Audio" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="tools.voice_injection_virtual_microphone" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="tools.converts_tts_wav_bit_khz"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="AudioStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <CheckBox x:Name="LoopAudioCheck" Content="tools.loop_wav" IsChecked="False" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="PickSpeakingWav_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="OpenFile" />
                                    <TextBlock Text="tools.choose_wav_prepare" />
                                </StackPanel>
                            </Button>
                            <Button Click="UseLastTtsWav_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Audio" />
                                    <TextBlock Text="tools.use_latest_tts_wav" />
                                </StackPanel>
                            </Button>
                            <Button Click="LaunchEtsWithFakeMic_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="tools.launch_ets_virtual_microphone" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <SymbolIcon Symbol="Message" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="tools.deepseek_speaking_test" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <ProgressRing x:Name="DeepSeekProgress" Grid.Column="1" Width="20" Height="20"
                                          IsActive="False" />
                        </Grid>
                        <TextBlock Text="tools.model_deepseek_flash_every_request"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <TextBlock x:Name="DeepSeekStatusText" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <Button Click="LoadSpeakingQuestions_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="tools.load_all_speaking_questions" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="SpeakingPaperBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display"
                                  PlaceholderText="tools.select_paper_available_after_loading"
                                  SelectionChanged="SpeakingPaperBox_SelectionChanged" />
                        <ComboBox x:Name="SpeakingQuestionBox" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="Display"
                                  PlaceholderText="tools.select_speaking_questions_available_after"
                                  SelectionChanged="SpeakingQuestionBox_SelectionChanged" />
                        <TextBox x:Name="SpeakingStemBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                 PlaceholderText="tools.enter_speaking_prompt_e_g" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AskDeepSeekButton" Click="AskDeepSeek_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Send" />
                                    <TextBlock x:Name="AskDeepSeekText" Text="tools.send_deepseek" />
                                </StackPanel>
                            </Button>
                            <Button Click="ClearSpeaking_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="tools.clear" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopySpeakingResult_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="tools.copy_result" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="SpeakingResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="150" PlaceholderText="tools.model_output_appears_here" />
                        <TextBlock Text="tools.aliyun_standard_tts_betty_american"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AliyunTtsButton" Click="AliyunTts_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="tools.generate_play_alibaba_cloud_tts" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="AliyunTtsProgress" Width="20" Height="20" IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="AliyunTtsStatusText" FontSize="12" Opacity="0.72"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>



                <StackPanel Spacing="2" Margin="4,8,0,0">
                    <TextBlock Text="tools.diagnostics_maintenance" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="tools.runtime_logs_packet_capture_app" FontSize="12" Opacity="0.62" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="ReportHacked" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="tools.app_information" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="EnvironmentText" FontFamily="Consolas" FontSize="12" Opacity="0.76"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="CopyEnvironment_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="tools.copy_environment_info" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenProgram_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="tools.open_app_folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="tools.verbose_logging" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="tools.when_enabled_info_traces_record"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VerboseLoggingToggle" Grid.Column="1" OnContent="common.on" OffContent="common.off"
                                      Toggled="VerboseLoggingToggle_Toggled" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="tools.diagnostic_log_viewer" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RefreshDiagnosticLogs_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="common.refresh_now" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DiagnosticLogViewerStatusText" FontSize="12" Opacity="0.68"
                                   Text="tools.loading_logs" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <CheckBox x:Name="InfoLogFilter" Content="INFO" IsChecked="True" Click="DiagnosticLogFilter_Click" />
                            <CheckBox x:Name="WarnLogFilter" Content="WARN" IsChecked="True" Click="DiagnosticLogFilter_Click" />
                            <CheckBox x:Name="ErrorLogFilter" Content="ERROR" IsChecked="True" Click="DiagnosticLogFilter_Click" />
                            <CheckBox x:Name="FatalLogFilter" Content="FATAL" IsChecked="True" Click="DiagnosticLogFilter_Click" />
                        </StackPanel>
                        <TextBox x:Name="DiagnosticLogText" Height="340" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Document" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="tools.logs_diagnostics" FontSize="17" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="LogSummaryText" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="tools.export_includes_engine_logs_ets"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ExportLogs_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="tools.export_log_zip" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenData_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="tools.open_engine_log_folder" />
                                </StackPanel>
                            </Button>
                            <Button Click="OpenDiagnosticLogs_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Folder" />
                                    <TextBlock Text="tools.open_diagnostic_log_folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>



                <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="#7F1D1D" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <SymbolIcon Symbol="Important" Foreground="#EF4444" />
                            <TextBlock Text="tools.full_reset" FontSize="17" FontWeight="SemiBold" Foreground="#EF4444" />
                        </StackPanel>
                        <TextBlock Text="tools.stops_listener_removes_autostart_shortcuts"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <Button Click="FullReset_Click" Background="#DC2626" Foreground="White" BorderBrush="#DC2626">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Delete" Foreground="White" />
                                <TextBlock Text="tools.full_reset" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
