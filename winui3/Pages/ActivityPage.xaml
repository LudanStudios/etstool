<Page
    x:Class="ETSAssistant.WinUI3.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="ActivityTemplate">
            <Border Padding="18" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="36,*" ColumnSpacing="14">
                    <ProgressRing Width="26" Height="26" IsActive="{Binding IsRunning}"
                                  IsIndeterminate="True" VerticalAlignment="Top"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Opacity="0.78" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding TimeText}" FontSize="12" Opacity="0.62" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{Binding OutputActionsVisibility}">
                            <Button Content="activity.view_pdf_app" Click="PreviewPdf_Click" Padding="10,5" />
                            <Button Content="activity.open_default_app" Click="OpenPdf_Click" Padding="10,5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ResponsiveContent" Margin="30,26,30,30" RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
            <SymbolIcon x:Name="HeaderSyncIcon" Symbol="Sync" Width="25" Height="25"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
            <ProgressRing x:Name="HeaderRing" Width="25" Height="25" IsActive="False"
                          IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="common.activity" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="activity.view_analyses_progress_recently_completed"
                       FontSize="15" Opacity="0.72" />
        </Grid>

        <InfoBar x:Name="ActivityInfo" Grid.Row="1" IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock x:Name="RunningHeader" Text="activity.progress" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl x:Name="RunningItems" ItemTemplate="{StaticResource ActivityTemplate}" />
                <TextBlock x:Name="EmptyText" Text="activity.there_no_activities_progress"
                           Opacity="0.65" Margin="0,4,0,8" />
                <TextBlock x:Name="CompletedHeader" Text="activity.recently_completed" FontSize="18" FontWeight="SemiBold"
                           Margin="0,8,0,0" />
                <ItemsControl x:Name="CompletedItems" ItemTemplate="{StaticResource ActivityTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
