<Page
    x:Class="ETSAssistant.WinUI3.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel x:Name="ResponsiveContent" Margin="24,20,24,20" Spacing="14">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                <SymbolIcon Symbol="Contact" VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="关于" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="版本信息与项目链接。" FontSize="14" Opacity="0.72" />
            </Grid>

            <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Image Source="ms-appx:///Assets/AboutBackground.png" Width="500" Height="430"
                           Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Opacity="0.25" IsHitTestVisible="False" />
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Image Source="ms-appx:///Assets/ProgramIcon.png" Width="56" Height="56"
                                   Stretch="Uniform" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ETS Tool" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="by @azursmelt" FontSize="13" Opacity="0.72" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Text="版本" Opacity="0.68" />
                            <TextBlock x:Name="VersionText" Grid.Column="1" FontWeight="SemiBold"
                                       IsTapEnabled="True" Tapped="VersionText_Tapped" />
                            <TextBlock Grid.Row="1" Text="发布时间" Opacity="0.68" />
                            <TextBlock x:Name="ReleaseText" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" Text="作者" Opacity="0.68" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="@azursmelt" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Comments" FontWeight="SemiBold" />
                            <TextBlock Text="重构 UI，基于 WinUI 3 实现的解决方案，新增大量功能。"
                                       Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel Spacing="3">
                                <TextBlock Text="关注项目" FontWeight="SemiBold" />
                                <HyperlinkButton Click="OpenProject_Click"
                                                 Content="https://github.com/LudanStudios/etstool"
                                                 Padding="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Furry 欢迎扩列~" FontWeight="SemiBold" />
                                <HyperlinkButton Click="OpenHomepage_Click"
                                                 Content="https://azursmelt.pages.dev" Padding="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
