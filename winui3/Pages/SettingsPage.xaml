<Page
    x:Class="ETSAssistant.WinUI3.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel x:Name="ResponsiveContent" Margin="30,26,30,30" Spacing="20">
            <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                <SymbolIcon Symbol="Setting" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Width="28" Height="28" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="common.answer_settings" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="settings.configure_answer_behavior_listener_speaking" FontSize="15" Opacity="0.72" />
            </Grid>
            <Border Padding="20" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="automation.title" FontSize="17" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel><TextBlock Text="automation.selection" FontWeight="SemiBold" />
                            <TextBlock Text="automation.selection_description" TextWrapping="Wrap" Opacity="0.7" /></StackPanel>
                        <ToggleSwitch x:Name="SelectionToggle" Grid.Column="1" OnContent="common.on" OffContent="common.off" Toggled="SelectionToggle_Toggled" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel><TextBlock Text="automation.speaking" FontWeight="SemiBold" />
                            <TextBlock Text="automation.speaking_description" TextWrapping="Wrap" Opacity="0.7" /></StackPanel>
                        <ToggleSwitch x:Name="SpeakingToggle" Grid.Column="1" OnContent="common.on" OffContent="common.off" Toggled="SpeakingToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="18">
                    <StackPanel x:Name="AccuracySettings" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="settings.target_accuracy" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccuracyText" Grid.Column="1" Text="100%" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="settings.assistant_selects_correct_answer_this" Opacity="0.7" />
                        <Slider x:Name="AccuracySlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="AccuracySlider_ValueChanged" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <StackPanel x:Name="SkipSettings" Spacing="7">
                            <TextBlock Text="settings.skip_interval_seconds" FontWeight="SemiBold" />
                            <NumberBox x:Name="SkipBox" Minimum="0" Maximum="60" SmallChange="0.5"
                                       SpinButtonPlacementMode="Inline" Value="0" ValueChanged="SkipBox_ValueChanged" />
                            <TextBlock Text="settings.set_minimum_retry_interval_next" FontSize="12" Opacity="0.68" />
                        </StackPanel>
                        <StackPanel x:Name="SpeakingSettings" Grid.Column="1" Spacing="7">
                            <TextBlock Text="settings.speaking_mode" FontWeight="SemiBold" />
                            <ComboBox x:Name="SpeakingModeBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="SpeakingModeBox_SelectionChanged">
                                <ComboBoxItem Content="settings.answer_key_mode_use_paper" Tag="standard" />
                                <ComboBoxItem Content="settings.generated_mode_use_deepseek_generate" Tag="flexible" />
                            </ComboBox>
                            <TextBlock Text="settings.generated_mode_requires_personal_deepseek"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="3">
                        <CheckBox x:Name="AutostartCheck" Content="settings.start_listener_background_when_sign" Click="Autostart_Click" />
                        <TextBlock Text="settings.wait_ets_start_show_assistant" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <CheckBox x:Name="MinimizeToTrayCheck" IsChecked="False"
                                  Click="MinimizeToTray_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="settings.minimize_to_tray" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource BetaBadgeStyle}">
                                    <TextBlock Text="BETA" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#FF5B430F" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="settings.minimize_to_tray_description"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <InfoBar x:Name="SaveInfoBar" IsOpen="False" />
                    <TextBlock Text="settings.saved_applied_automatically" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="5">
                        <TextBlock Text="settings.vb_cable_virtual_audio_device" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="CableStatusText" Text="settings.checking_virtual_audio_device" FontSize="12" Opacity="0.72"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="settings.manage_driver_here_installing_uninstalling"
                                   FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallVirtualCableButton" Click="InstallVirtualCable_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Download" /><TextBlock Text="settings.install_driver" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UninstallVirtualCableButton" Click="UninstallVirtualCable_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Delete" /><TextBlock Text="settings.uninstall_driver" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshVirtualCableButton" Click="RefreshVirtualCable_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Refresh" /><TextBlock Text="common.refresh_status" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <InfoBar x:Name="CableInfoBar" IsOpen="False" />
                </StackPanel>
            </Border>
            <Expander x:Name="CredentialsExpander" IsExpanded="False" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                          MinHeight="88" CornerRadius="16" Padding="24">
                    <Expander.Header>
                        <StackPanel Spacing="5" Margin="8,0,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="settings.service_credentials_needed" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="settings.personal_credentials_stored_locally_deepseek"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="20" HorizontalAlignment="Stretch" Loaded="CredentialsContent_Loaded">
                    <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                            <TextBlock Text="settings.ets_installation_folder" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock x:Name="EtsPathText" TextWrapping="Wrap" Opacity="0.72"
                                       HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <Button Click="ChooseEtsFolder_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock Text="settings.choose_installation_folder"/></StackPanel></Button>
                                <Button Click="Rescan_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="16"/><TextBlock Text="settings.rescan"/></StackPanel></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                            <TextBlock Text="DeepSeek API Key" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock Text="settings.used_speaking_generation_paper_analysis"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <PasswordBox x:Name="ApiKeyBox" PlaceholderText="settings.paste_deepseek_api_key_sk"
                                         PasswordRevealMode="Peek" MinHeight="44" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="ApiKeyStatusText" FontSize="12" Opacity="0.7" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <Button Click="SaveApiKey_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;" FontSize="16"/><TextBlock Text="settings.save_key"/></StackPanel></Button>
                                <Button Click="ClearApiKey_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock Text="settings.clear_key"/></StackPanel></Button>
                            </StackPanel>
                            <InfoBar x:Name="ApiKeyInfoBar" IsOpen="False" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                            <TextBlock Text="settings.alibaba_cloud_tts_ram_credentials" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock Text="settings.use_personal_ram_credentials_tts"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <TextBox x:Name="AliyunRamNameBox" Header="RAM Name / AccessKey ID" MinHeight="44" HorizontalAlignment="Stretch" />
                            <PasswordBox x:Name="AliyunRamKeyBox" Header="RAM Key / AccessKey Secret"
                                         PasswordRevealMode="Peek" MinHeight="44" HorizontalAlignment="Stretch" />
                            <PasswordBox x:Name="AliyunAppIdBox" Header="TTS AppID / AppKey"
                                         PasswordRevealMode="Peek" MinHeight="44" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="AliyunStatusText" FontSize="12" Opacity="0.7" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <Button Click="SaveAliyun_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;" FontSize="16"/><TextBlock Text="settings.save_alibaba_cloud_credentials"/></StackPanel></Button>
                                <Button Click="ClearAliyun_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock Text="settings.clear_alibaba_cloud_credentials"/></StackPanel></Button>
                            </StackPanel>
                            <InfoBar x:Name="AliyunInfoBar" IsOpen="False" />
                        </StackPanel>
                    </Border>
                    <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                            <TextBlock Text="settings.import_credentials_csv" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock Text="settings.import_deepseek_alibaba_cloud_tts"
                                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14"
                                    HorizontalAlignment="Stretch">
                                <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           Text="type,api_key,access_key_id,access_key_secret,app_key&#x0a;deepseek,sk-xxxx,,,&#x0a;aliyun,,LTAIxxxx,secret,appkey" />
                            </Border>
                            <TextBlock Text="settings.headerless_form_also_supported_deepseek"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" HorizontalAlignment="Left" />
                            <Button Click="ImportCsv_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B5;" FontSize="16"/><TextBlock Text="settings.choose_csv_import"/></StackPanel></Button>
                            <TextBlock x:Name="CsvImportStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <InfoBar x:Name="CsvImportInfoBar" IsOpen="False" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
